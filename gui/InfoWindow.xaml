<Window x:Class="BoxRun.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="抽屉信息" Width="620" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F2F2F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="HeadText" Text="抽屉信息" FontSize="24" FontWeight="Bold"/>
      <TextBlock x:Name="SubText" Text="" Foreground="#86868B" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="SectionsPanel"/>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="HintText" Text="" Foreground="#A1A1A6" FontSize="10" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="数据目录" Padding="14,8" BorderThickness="0" Background="#E9E9ED"
                Margin="0,0,8,0" Click="OpenDataBtn_Click"/>
        <Button Content="刷新" Padding="14,8" BorderThickness="0" Background="#E9E9ED"
                Margin="0,0,8,0" Click="RefreshBtn_Click"/>
        <Button Content="关闭" Padding="14,8" BorderThickness="0" Background="#E9E9ED"
                IsCancel="True" Click="CloseBtn_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
