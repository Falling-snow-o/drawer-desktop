<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Drawer</AssemblyName>
    <RootNamespace>BoxRun</RootNamespace>
    <ApplicationIcon>..\boxrun.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>1.0.0</Version>
    <AssemblyTitle>Drawer Desktop</AssemblyTitle>
    <Product>Drawer Desktop</Product>
    <Company>Drawer Desktop contributors</Company>
    <Description>Portable WSL drawer manager for Windows</Description>
    <Copyright>MIT License</Copyright>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
