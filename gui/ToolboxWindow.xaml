<Window x:Class="BoxRun.ToolboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工具箱" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F2F2F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#E9E9ED"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DEDEE3"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0071E3"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0077ED"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <StackPanel Margin="22">
    <TextBlock Text="工具箱" FontSize="22" FontWeight="Bold"/>
    <TextBlock x:Name="SubText" Text="" Foreground="#86868B" FontSize="12" Margin="0,4,0,14"/>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <RadioButton x:Name="TabClean" Content="清理" GroupName="tab" IsChecked="True"
                   FontWeight="SemiBold" Margin="0,0,18,0" Checked="Tab_Checked"/>
      <RadioButton x:Name="TabInstall" Content="安装" GroupName="tab"
                   FontWeight="SemiBold" Margin="0,0,18,0" Checked="Tab_Checked"/>
      <RadioButton x:Name="TabPlugin" Content="插件" GroupName="tab"
                   FontWeight="SemiBold" Checked="Tab_Checked"/>
    </StackPanel>

    <Border Background="#FFFFFF" CornerRadius="10" Padding="12,0" Height="34" Margin="0,0,0,10">
      <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
               VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
               ToolTip="搜索名称或 id"/>
    </Border>

    <Border Background="#FFFFFF" CornerRadius="14" Padding="14">
      <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ListPanel"/>
      </ScrollViewer>
    </Border>

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Background="#FFFFFF" CornerRadius="10" Height="36" Padding="12,0">
        <TextBox x:Name="PkgBox" BorderThickness="0" Background="Transparent"
                 VerticalContentAlignment="Center" ToolTip="任意 apt 包名，例如 htop ripgrep sl"/>
      </Border>
      <Button Grid.Column="1" Content="自定义安装" Margin="8,0,0,0" Click="CustomBtn_Click"/>
    </Grid>

    <Grid Margin="0,14,0,0">
      <TextBlock x:Name="HintText" Text="" Foreground="#86868B" FontSize="11" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="UpdateBtn" Content="更新目录" Click="UpdateBtn_Click"/>
        <Button x:Name="CancelBtn" Content="取消" Click="CancelBtn_Click"/>
        <Button x:Name="RunBtn" Content="执行选中" Style="{StaticResource Accent}" Click="RunBtn_Click"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
