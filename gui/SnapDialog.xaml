<Window x:Class="BoxRun.SnapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快照" Width="640" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F2F2F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <Window.Resources>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="2" Opacity="0.08" Color="#000000"/>

    <Style x:Key="BaseBtn" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="#ECECF0" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#E2E2E8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#D8D8DF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="#0A84FF" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#0071E3"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#0062C4"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
      <Setter Property="Foreground" Value="#D70015"/>
    </Style>
  </Window.Resources>

  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="快照" FontSize="24" FontWeight="Bold"/>
      <TextBlock x:Name="HeadText" Margin="0,4,0,0" Foreground="#86868B" FontSize="12"/>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,16,0,0" Background="#FFFFFF" CornerRadius="16"
            Effect="{StaticResource CardShadow}">
      <Grid>
        <ListView x:Name="SnapList" Margin="8" BorderThickness="0" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Single">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Margin" Value="0,2"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="row" Background="Transparent" CornerRadius="10" Padding="12,10">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="row" Property="Background" Value="#F5F5F9"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="row" Property="Background" Value="#E8F1FF"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListView.ItemContainerStyle>

          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#86868B"
                           Margin="0,0,18,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ShaText}" Foreground="#34C759"
                         FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{Binding Created}" Foreground="#A1A1A6"
                           FontSize="12" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Text="还没有快照" Foreground="#A1A1A6"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Border Background="#FFFFFF" CornerRadius="10" Height="36" Padding="12,0">
        <TextBox x:Name="TagBox" BorderThickness="0" Background="Transparent"
                 VerticalContentAlignment="Center" ToolTip="新快照的标签"/>
      </Border>

      <Button Grid.Column="1" Content="新建快照" Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0" Click="CreateBtn_Click"/>
      <Button Grid.Column="2" Content="还原选中" Style="{StaticResource BaseBtn}" Margin="8,0,0,0" Click="RestoreBtn_Click"/>
      <Button Grid.Column="3" Content="删除选中" Style="{StaticResource DangerBtn}" Margin="8,0,0,0" Click="DeleteBtn_Click"/>
      <Button Grid.Column="4" Content="关闭" Style="{StaticResource BaseBtn}" Margin="8,0,0,0" IsCancel="True" Click="CloseBtn_Click"/>
    </Grid>
  </Grid>
</Window>
