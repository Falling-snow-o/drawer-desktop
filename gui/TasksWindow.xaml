<Window x:Class="BoxRun.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent 任务" Width="980" Height="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F2F2F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
          <TextBlock Text="任务" FontSize="18" FontWeight="Bold"/>
          <Button Content="刷新" HorizontalAlignment="Right" Padding="12,5"
                  BorderThickness="0" Background="#E9E9ED" Click="RefreshBtn_Click"/>
        </Grid>
        <ListBox x:Name="TaskList" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0"
                 Background="Transparent" SelectionChanged="TaskList_SelectionChanged"/>
      </Grid>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock x:Name="TitleText" Text="未选择任务" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="SubText" Text="" Foreground="#86868B" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>

      <ListBox x:Name="StepList" Grid.Row="1" Height="170" Margin="0,12,0,10"
               BorderThickness="0" Background="#FFFFFF" SelectionChanged="StepList_SelectionChanged"/>

      <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="12" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBox x:Name="DetailBox" BorderThickness="0" Background="Transparent"
                   FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                   IsReadOnly="True" TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="提交到宿主" Padding="14,7" BorderThickness="0" Background="#0071E3"
                Foreground="White" Click="CommitBtn_Click"/>
        <Button Content="回滚" Padding="14,7" Margin="8,0,0,0" BorderThickness="0"
                Background="#E9E9ED" Click="RollbackBtn_Click"/>
        <Button Content="关闭" Padding="14,7" Margin="8,0,0,0" BorderThickness="0"
                Background="#E9E9ED" Click="CloseBtn_Click" HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
