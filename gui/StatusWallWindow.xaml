<Window x:Class="BoxRun.StatusWallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="状态墙" Width="560" Height="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F2F2F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="状态墙" FontSize="22" FontWeight="Bold"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
          <Border Width="12" Height="12" CornerRadius="3" Background="#34C759" VerticalAlignment="Center"/>
          <TextBlock Text="正常（已停止）" Margin="6,0,0,0" Foreground="#86868B" FontSize="11"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
          <Border Width="12" Height="12" CornerRadius="3" Background="#FF9F0A" VerticalAlignment="Center"/>
          <TextBlock Text="运行中" Margin="6,0,0,0" Foreground="#86868B" FontSize="11"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="12" Height="12" CornerRadius="3" Background="#FF3B30" VerticalAlignment="Center"/>
          <TextBlock Text="异常 / 未构建" Margin="6,0,0,0" Foreground="#86868B" FontSize="11"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,16,0,0" Background="#FFFFFF" CornerRadius="14" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <WrapPanel x:Name="WallPanel"/>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="HintText" Foreground="#A1A1A6" FontSize="11" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="刷新" Padding="14,8" BorderThickness="0" Background="#E9E9ED"
                Margin="0,0,8,0" Click="RefreshBtn_Click"/>
        <Button Content="关闭" Padding="14,8" BorderThickness="0" Background="#E9E9ED"
                IsCancel="True" Click="CloseBtn_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
