<Window x:Class="BoxRun.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F2F2F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <StackPanel Margin="22">
    <TextBlock Text="构建设置" FontSize="22" FontWeight="Bold"/>
    <TextBlock Text="对新建抽屉和装包生效" Foreground="#86868B" FontSize="12" Margin="0,4,0,14"/>

    <TextBlock Text="apt 镜像" Foreground="#86868B" FontSize="11" Margin="2,0,0,4"/>
    <ComboBox x:Name="MirrorBox" Height="34" Margin="0,0,0,12">
      <ComboBoxItem Tag="tuna" Content="清华 TUNA（默认）"/>
      <ComboBoxItem Tag="aliyun" Content="阿里云"/>
      <ComboBoxItem Tag="ustc" Content="中科大 USTC"/>
      <ComboBoxItem Tag="official" Content="官方源（不替换）"/>
    </ComboBox>

    <CheckBox x:Name="BaseChk" Content="使用预烘基础镜像（新建更快，含预装软件）" Margin="0,0,0,8"/>
    <CheckBox x:Name="CacheChk" Content="共享 apt 下载缓存（装包不重复下载）" Margin="0,0,0,4"/>

    <CheckBox x:Name="ResticChk" Content="使用 restic 增量快照（需 restic.exe，失败自动回退 tar）" Margin="0,0,0,12"/>

    <TextBlock Text="更新源（latest.json 的 URL，留空则不检查）" Foreground="#86868B" FontSize="11" Margin="2,0,0,4"/>
    <TextBox x:Name="UpdateUrlBox" Height="30" Margin="0,0,0,4"/>
    <TextBlock Text="格式：{&quot;version&quot;:&quot;1.2.0&quot;,&quot;url&quot;:&quot;https://…/drawer-setup.exe&quot;,&quot;sha256&quot;:&quot;…&quot;,&quot;notes&quot;:&quot;…&quot;}"
               Foreground="#A1A1A6" FontSize="10" TextWrapping="Wrap" Margin="2,0,0,14"/>

    <Border Background="#FFFFFF" CornerRadius="10" Padding="12" Margin="0,10,0,0">
      <Grid>
        <StackPanel>
          <TextBlock Text="apt 下载缓存" FontWeight="SemiBold"/>
          <TextBlock x:Name="CacheText" Text="" Foreground="#86868B" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>
        <Button Content="清空" HorizontalAlignment="Right" VerticalAlignment="Center"
                Padding="14,6" BorderThickness="0" Background="#E9E9ED" Click="ClearCacheBtn_Click"/>
      </Grid>
    </Border>

    <Grid Margin="0,16,0,0">
      <TextBlock x:Name="PathText" Foreground="#A1A1A6" FontSize="10" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Padding="14,8" BorderThickness="0" Background="#E9E9ED"
                Margin="0,0,8,0" IsCancel="True" Click="CancelBtn_Click"/>
        <Button Content="保存" Padding="16,8" BorderThickness="0"
                Background="#0A84FF" Foreground="White" Click="SaveBtn_Click"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
