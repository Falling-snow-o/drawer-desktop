<Window x:Class="BoxRun.PortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="端口" Width="520" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F2F2F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="HeadText" Text="端口" FontSize="22" FontWeight="Bold"/>
      <TextBlock x:Name="SubText" Text="" Foreground="#86868B" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,14,0,0" Background="#FFFFFF" CornerRadius="14">
      <ListView x:Name="PortList" Margin="8" BorderThickness="0" Background="Transparent"
                MouseDoubleClick="PortList_MouseDoubleClick">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Margin="6,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding PortText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="{Binding Url}" Foreground="#86868B" FontSize="12"/>
              <Button Grid.Column="2" Content="打开" Padding="12,4" BorderThickness="0"
                      Background="#E9E9ED" Click="OpenBtn_Click" Tag="{Binding Port}"/>
              <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#86868B"
                         FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="56"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <TextBlock x:Name="HintText" Foreground="#A1A1A6" FontSize="10" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="刷新" Padding="14,8" BorderThickness="0" Background="#E9E9ED"
                Margin="0,0,8,0" Click="RefreshBtn_Click"/>
        <Button Content="关闭" Padding="14,8" BorderThickness="0" Background="#E9E9ED"
                IsCancel="True" Click="CloseBtn_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
