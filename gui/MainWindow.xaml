<Window x:Class="BoxRun.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BoxRun"
        Title="Drawer Desktop" Width="1120" Height="720" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F7" Foreground="#1D1D1F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <Window.Resources>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="26" ShadowDepth="2" Opacity="0.10" Color="#000000"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="22"/>
      <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#86868B"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#E9E9ED"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,11"/>
      <Setter Property="Margin" Value="5,0,5,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                    Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                      <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#DEDEE3"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0071E3"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#0077ED"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#D2D2D7"/>
          <Setter Property="Opacity" Value="1"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border x:Name="Root" Background="#FFFFFF" BorderBrush="#E5E5EA" BorderThickness="1"
                    CornerRadius="10" Padding="6" MinWidth="120">
              <Border.RenderTransform>
                <TranslateTransform Y="-14"/>
              </Border.RenderTransform>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel IsItemsHost="True"/>
              </ScrollViewer>
            </Border>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="ContextMenu.Opened">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="-14" To="0" Duration="0:0:0.20">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="HdrBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#FFF0EF"/>
      <Setter Property="Foreground" Value="#D70015"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FFE3E1"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#F2F2F7"/>
          <Setter Property="Foreground" Value="#C7C7CC"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid" Background="#F2F2F7">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左侧 -->
    <Border Grid.Column="0" Background="#FBFBFD" BorderBrush="#ECECF1" BorderThickness="0,0,1,0">
      <Grid Margin="14,20,14,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,22">
          <TextBlock Text="Drawer Desktop" FontSize="22" FontWeight="Bold"/>
          <TextBlock x:Name="VerText" Text="v1.0" Margin="8,0,0,5"
                     VerticalAlignment="Bottom" Foreground="#86868B" FontSize="11"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="6,0,6,10">
          <Grid>
            <TextBlock Text="抽屉" Foreground="#86868B" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock x:Name="CountText" Text="" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="#A1A1A6" FontSize="11"/>
          </Grid>
          <ComboBox x:Name="TagFilter" Height="26" Margin="0,6,0,0" FontSize="11"
                    SelectionChanged="TagFilter_SelectionChanged"/>
        </StackPanel>

        <ListBox x:Name="BoxList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                 SelectionMode="Extended"
                 SelectionChanged="BoxList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="设置显示别名…" Click="AliasMenu_Click"/>
              <Separator/>
              <MenuItem Header="启动选中" Click="BatchStart_Click"/>
              <MenuItem Header="停止选中" Click="BatchStop_Click"/>
              <MenuItem Header="删除选中" Click="BatchDelete_Click"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                <Border Background="#EFEFF4" CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                        Visibility="{Binding TagVis}">
                  <TextBlock Text="{Binding TagText}" FontSize="10" Foreground="#86868B"/>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#A1A1A6" Margin="2,8,0,4"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,10"/>
              <Setter Property="Margin" Value="0,2"/>
              <Setter Property="FontSize" Value="13"/>
              <Setter Property="Foreground" Value="#1D1D1F"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="b" Property="Background" Value="#EFEFF4"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="b" Property="Background" Value="#E3EDFC"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
          <UniformGrid Columns="2">
            <Button x:Name="AddBtn" Content="＋ 添加" Margin="0,0,4,6" FontSize="12" Click="AddBtn_Click"/>
            <Button x:Name="ScanBtn" Content="查找" Margin="4,0,0,6" FontSize="12" Click="ScanBtn_Click"/>
            <Button x:Name="CloneBtn" Content="克隆" Margin="0,0,4,6" FontSize="12" Click="CloneBtn_Click"/>
            <Button x:Name="NewFromTplBtn" Content="模板新建" Margin="4,0,0,6" FontSize="12" Click="NewFromTplBtn_Click"/>
            <Button x:Name="ExportMenuBtn" Content="导出 ▾" Margin="0,0,4,0" FontSize="12" Click="OpenMenu_Click">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="导出模板" Click="TplBtn_Click"/>
                  <MenuItem Header="导出应用到开始菜单" Click="ExportBtn_Click"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="ToolBtn" Content="工具箱" Margin="4,0,0,0" FontSize="12" Click="ToolBtn_Click"/>
          </UniformGrid>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="6,12,6,0">
          <Border x:Name="NoticeBar" Background="#EEF6FF" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
            <Grid>
              <TextBlock Text="关窗口不会删除抽屉，数据仍在磁盘" FontSize="10" Foreground="#5A6B7C"
                         TextWrapping="Wrap" Margin="0,0,12,0"/>
              <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="2,0"
                      BorderThickness="0" Background="Transparent" Foreground="#8A9AAB"
                      FontSize="12" Click="NoticeDismiss_Click"/>
            </Grid>
          </Border>
          <CheckBox x:Name="IdleChk" Content="空闲 5 分钟自动停止" IsChecked="True"
                    Foreground="#86868B" FontSize="10"/>
          <TextBlock x:Name="FootText" Text="" Foreground="#B0B0B6" FontSize="9"
                     TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 右侧 -->
    <Grid Grid.Column="1" Margin="26,20,26,14">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F7F8FC" Offset="0"/>
          <GradientStop Color="#EDEFF6" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="110"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock x:Name="StateVal" Text="—" FontSize="26" FontWeight="Bold"/>
          <TextBlock x:Name="PathVal" Text="—" FontSize="11" Foreground="#86868B"
                     Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="PanelBtn" Content="面板 ▾" Style="{StaticResource HdrBtn}" Click="PanelBtn_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="状态墙" Click="WallBtn_Click"/>
                <MenuItem Header="端口" Click="PortBtn_Click"/>
                <MenuItem Header="标签…" Click="TagBtn_Click"/>
                <Separator/>
                <MenuItem Header="检查更新…" Click="UpdateMenu_Click"/>
                <MenuItem Header="导出诊断包…" Click="DiagMenu_Click"/>
                <MenuItem Header="协同…" Click="CollabMenu_Click"/>
                <MenuItem Header="Agent 任务…" Click="AgentMenu_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Border Width="1" Background="#E3E3E8" Margin="10,4,6,4"/>
          <Button x:Name="InfoBtn" Content="信息" Style="{StaticResource HdrBtn}" Click="InfoBtn_Click"/>
          <Button x:Name="SetBtn" Content="设置" Style="{StaticResource HdrBtn}" Click="SetBtn_Click"/>
          <Button x:Name="FullBtn" Content="全屏" Style="{StaticResource HdrBtn}" Click="FullBtn_Click"/>
          <Button x:Name="RefreshBtn" Content="刷新" Style="{StaticResource HdrBtn}" Click="RefreshBtn_Click"/>
          <Button x:Name="DeleteBtn" Content="删除" Style="{StaticResource Danger}" Margin="8,0,0,0"
                  Click="DeleteBtn_Click"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="CPU" Style="{StaticResource Lbl}" Margin="0"/>
            <TextBlock x:Name="CpuVal" HorizontalAlignment="Right" FontSize="12"/>
          </Grid>
          <Border x:Name="CpuTrack" Grid.Row="1" Height="10" CornerRadius="5" Background="#EFEFF4" Margin="0,0,0,16">
            <Border x:Name="CpuBar" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="#0071E3"/>
          </Border>

          <Grid Grid.Row="2" Margin="0,0,0,6">
            <TextBlock Text="内存" Style="{StaticResource Lbl}" Margin="0"/>
            <TextBlock x:Name="MemVal" HorizontalAlignment="Right" FontSize="12"/>
          </Grid>
          <Border x:Name="MemTrack" Grid.Row="3" Height="10" CornerRadius="5" Background="#EFEFF4" Margin="0,0,0,16">
            <Border x:Name="MemBar" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="#34C759"/>
          </Border>

          <Grid Grid.Row="4" Margin="0,0,0,6">
            <TextBlock Text="进程" Style="{StaticResource Lbl}" Margin="0"/>
            <TextBlock x:Name="PidsVal" HorizontalAlignment="Right" FontSize="12"/>
          </Grid>
          <Border x:Name="PidTrack" Grid.Row="5" Height="10" CornerRadius="5" Background="#EFEFF4">
            <Border x:Name="PidBar" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="#FF9F0A"/>
          </Border>

          <Grid x:Name="SparkRow" Grid.Row="6" Margin="0,14,0,4">
            <TextBlock Text="内存趋势" Style="{StaticResource Lbl}" Margin="0"/>
            <TextBlock x:Name="SparkHint" HorizontalAlignment="Right" FontSize="10" Foreground="#A1A1A6"/>
          </Grid>
          <local:Sparkline x:Name="MemSpark" Grid.Row="7" Height="26"/>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#F7F7FA" CornerRadius="14" Padding="16,12" Margin="0,12,0,0">
        <UniformGrid Columns="4">
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="内核" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="KernelVal" Text="—" FontSize="12" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="已运行" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="UptimeVal" Text="—" FontSize="12"/>
          </StackPanel>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="根盘" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="DiskVal" Text="—" FontSize="12"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="显存上限" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="VramVal" Text="—" FontSize="12"/>
          </StackPanel>
          <StackPanel Margin="0,12,10,0">
            <TextBlock Text="GPU 直通" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="GpuVal" Text="—" FontSize="12"/>
          </StackPanel>
          <StackPanel Margin="0,12,10,0">
            <TextBlock Text="data 挂载" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="MountVal" Text="—" FontSize="12"/>
          </StackPanel>
          <StackPanel Margin="0,12,10,0">
            <TextBlock Text="挂载点" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="LocVal" Text="—" FontSize="12" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="注册" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="BuiltVal" Text="—" FontSize="12"/>
          </StackPanel>
        </UniformGrid>
      </Border>

      <UniformGrid Grid.Row="3" Columns="3" VerticalAlignment="Top" Margin="0,12,0,0">
        <Button x:Name="StartBtn" Content="▶  启动" Style="{StaticResource Accent}" Height="42" Margin="0,0,5,5" Click="StartBtn_Click"/>
        <Button x:Name="TermBtn" Content="终端" Height="42" Margin="5,0,5,5" Click="TermBtn_Click"/>
        <Button x:Name="DesktopMenuBtn" Content="桌面 ▾" Height="42" Margin="5,0,0,5" Click="OpenMenu_Click">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="完整桌面（XFCE）" Click="DeskBtn_Click"/>
              <MenuItem Header="文件管理器" Click="FilesBtn_Click"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button x:Name="RestoreBtn" Content="恢复初始" Height="42" Margin="0,5,5,0" Click="RestoreBtn_Click"/>
        <Button x:Name="SnapBtn" Content="快照" Height="42" Margin="5,5,5,0" Click="SnapBtn_Click"/>
        <Button x:Name="DoctorBtn" Content="自检" Height="42" Margin="5,5,5,0" Click="DoctorBtn_Click"/>
      </UniformGrid>

      <Border Grid.Row="4" Background="#FBFBFD" CornerRadius="14" Margin="0,12,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="14,8,12,2">
            <TextBlock Text="输出" Foreground="#86868B" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="ProgressText" Foreground="#86868B" FontSize="11"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="CancelBtn" Content="取消" Visibility="Collapsed" Click="CancelBtn_Click" Margin="0,0,8,0"/>
          <Button x:Name="ClearLogBtn" Content="清空" Padding="10,2" FontSize="11"
                      Background="Transparent" Foreground="#0071E3" Margin="0" Click="ClearLogBtn_Click"/>
            </StackPanel>
          </Grid>
          <ProgressBar x:Name="Bar" Grid.Row="0" Height="2" VerticalAlignment="Bottom"
                       Minimum="0" Maximum="100" IsIndeterminate="False" Visibility="Collapsed"
                       Foreground="#0071E3" Background="#E5E5EA" BorderThickness="0"/>
          <RichTextBox x:Name="LogBox" Grid.Row="1" Margin="12,0,12,10"
                       Background="Transparent" Foreground="#3A3A3C" BorderThickness="0"
                       FontFamily="Cascadia Mono, Consolas" FontSize="11.5" IsReadOnly="True"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </Border>

      <TextBlock x:Name="StatusLine" Grid.Row="5" Text="" Foreground="#A1A1A6"
                 FontSize="10" Margin="2,10,0,0"/>
    </Grid>
  <Border x:Name="ErrorBar" Grid.ColumnSpan="2" Background="#FF3B30" CornerRadius="10"
          Padding="14,10" Margin="0,0,0,18" VerticalAlignment="Bottom"
          HorizontalAlignment="Center" Panel.ZIndex="2000" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="ErrorText" Foreground="White" FontSize="12" MaxWidth="560" TextWrapping="Wrap"/>
      <Button Content="×" Margin="12,0,0,0" Foreground="White" Background="Transparent"
              BorderThickness="0" Click="ErrorDismiss_Click"/>
    </StackPanel>
  </Border>
</Grid>
</Window>
